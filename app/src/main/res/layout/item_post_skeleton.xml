<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <View
        android:id="@+id/skeleton_avatar"
        android:layout_width="@dimen/post_avatar_size"
        android:layout_height="@dimen/post_avatar_size"
        android:layout_marginStart="@dimen/spacing_md"
        android:background="@drawable/bg_avatar_placeholder"
        app:layout_constraintBottom_toTopOf="@id/skeleton_divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/skeleton_title"
        android:layout_width="0dp"
        android:layout_height="@dimen/skeleton_title_height"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_marginTop="@dimen/spacing_md"
        android:background="@drawable/bg_skeleton_bar"
        app:layout_constraintStart_toEndOf="@id/skeleton_avatar"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/skeleton_first_line"
        android:layout_width="0dp"
        android:layout_height="@dimen/skeleton_line_height"
        android:layout_marginTop="@dimen/skeleton_line_spacing"
        android:background="@drawable/bg_skeleton_bar"
        app:layout_constraintStart_toStartOf="@id/skeleton_title"
        app:layout_constraintTop_toBottomOf="@id/skeleton_title" />

    <View
        android:id="@+id/skeleton_second_line"
        android:layout_width="0dp"
        android:layout_height="@dimen/skeleton_line_height"
        android:layout_marginTop="@dimen/skeleton_line_spacing"
        android:layout_marginBottom="@dimen/spacing_md"
        android:background="@drawable/bg_skeleton_bar"
        app:layout_constraintBottom_toTopOf="@id/skeleton_divider"
        app:layout_constraintStart_toStartOf="@id/skeleton_title"
        app:layout_constraintTop_toBottomOf="@id/skeleton_first_line" />

    <View
        android:id="@+id/skeleton_divider"
        android:layout_width="0dp"
        android:layout_height="@dimen/divider_thickness"
        android:background="@color/outline"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/skeleton_second_line" />
</androidx.constraintlayout.widget.ConstraintLayout>
